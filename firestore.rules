rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'emquan292011@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 64 &&
             data.role in ['admin', 'user'] &&
             data.level is number && data.level >= 1 &&
             data.exp is number && data.exp >= 0 &&
             data.pixelCoins is number && data.pixelCoins >= 0 &&
             data.purchasedGenerals is list && data.purchasedGenerals.size() <= 50 &&
             data.selectedGeneral is string && data.selectedGeneral.size() <= 64 &&
             (!('skillPoints' in data) || (data.skillPoints is number && data.skillPoints >= 0)) &&
             (!('skillTree' in data) || data.skillTree is map);
    }

    function isValidAdminConfig(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.updatedBy is string && data.updatedBy.size() <= 128;
    }

    // 3. Health & Connectivity Check
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Admin Whitelist Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. User Profiles and Progression
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.id == request.auth.uid &&
                      (request.resource.data.role == 'user' || isAdmin());
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.id == resource.data.id &&
                      (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();
    }

    // 6. Admin Configuration & Game Overrides
    match /admin_configs/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(configId) && isValidAdminConfig(request.resource.data);
    }
  }
}
